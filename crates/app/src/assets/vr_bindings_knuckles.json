{
  "controller_type": "knuckles",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/main/in/trigger" } }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/main/in/trigger" } }
        }
      ]
    }
  }
}
