<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX manifest for cargo-wix. Produces a per-machine MSI that installs
  ez-wishlist-overlay.exe under %ProgramFiles%\EZ Wishlist Overlay\ and
  drops a Start Menu shortcut.

  The Product/@Id is '*' so each MSI build gets a fresh ProductCode; the
  fixed UpgradeCode below is what binds versions together for in-place
  upgrades. Do not change it once a release ships — that will break
  upgrade paths for existing installs.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='EZ Wishlist Overlay'
        UpgradeCode='CB9F74C8-0C2D-41DB-9CBF-51891635BA7F'
        Manufacturer='Etienne Chabert'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Hideout + task wishlist tracker for Contractors Showdown: ExfilZone, with SteamVR overlay.'
            Manufacturer='Etienne Chabert'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='EZ Wishlist Overlay Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramFiles64Folder' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='EZ Wishlist Overlay'>

                    <Component Id='License' Guid='*' Win64='yes'>
                        <File Id='LicenseFile'
                              Name='LICENSE'
                              DiskId='1'
                              Source='LICENSE'
                              KeyPath='yes'/>
                    </Component>

                    <Component Id='binary0' Guid='*' Win64='yes'>
                        <File Id='exe0'
                              Name='ez-wishlist-overlay.exe'
                              DiskId='1'
                              Source='target\release\ez-wishlist-overlay.exe'
                              KeyPath='yes'/>
                    </Component>

                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='EZ Wishlist Overlay'>
                    <Component Id='ApplicationShortcut'
                               Guid='5B3E9383-1A3D-49AC-9585-C9B6E7954CF9'
                               Win64='yes'>
                        <Shortcut Id='ApplicationStartMenuShortcut'
                                  Name='EZ Wishlist Overlay'
                                  Description='Tracker for ExfilZone hideout + tasks'
                                  Target='[#exe0]'
                                  WorkingDirectory='APPLICATIONFOLDER'/>
                        <RemoveFolder Id='CleanUpShortCut'
                                      Directory='ApplicationProgramsFolder'
                                      On='uninstall'/>
                        <RegistryValue Root='HKCU'
                                       Key='Software\etienneb\EZ Wishlist Overlay'
                                       Name='installed'
                                       Type='integer'
                                       Value='1'
                                       KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>

            <Directory Id='DesktopFolder' Name='Desktop'>
                <Component Id='DesktopShortcut'
                           Guid='E6BF98A4-5F88-4ADA-ADB9-84D700AB1E8B'
                           Win64='yes'>
                    <Shortcut Id='ApplicationDesktopShortcut'
                              Name='EZ Wishlist Overlay'
                              Description='Tracker for ExfilZone hideout + tasks'
                              Target='[#exe0]'
                              WorkingDirectory='APPLICATIONFOLDER'/>
                    <RegistryValue Root='HKCU'
                                   Key='Software\etienneb\EZ Wishlist Overlay'
                                   Name='desktop_shortcut_installed'
                                   Type='integer'
                                   Value='1'
                                   KeyPath='yes'/>
                </Component>
            </Directory>
        </Directory>

        <Feature Id='Binaries'
                 Title='Application'
                 Description='Installs the EZ Wishlist Overlay binary.'
                 Level='1'
                 ConfigurableDirectory='APPLICATIONFOLDER'
                 AllowAdvertise='no'
                 Display='expand'
                 Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ApplicationShortcut'/>
            <ComponentRef Id='DesktopShortcut'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- App icon shown in Add/Remove Programs and on the Start Menu shortcut. -->
        <Icon Id='AppIcon.ico' SourceFile='crates\app\assets\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='AppIcon.ico'/>

        <!-- Multi-screen installer UI so the user sees what's happening:
             Welcome → License → Install dir → Confirm → Progress → Finish.
             WixUI_InstallDir requires a license RTF (wix/License.rtf) and
             the WIXUI_INSTALLDIR property to point at the directory the
             user can change on the install-dir dialog. -->
        <UIRef Id='WixUI_InstallDir'/>
        <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>
        <WixVariable Id='WixUILicenseRtf' Value='crates\app\wix\License.rtf'/>

        <!-- "Launch EZ Wishlist Overlay" checkbox on the Finish dialog.
             WixUI_InstallDir's exit dialog renders the optional checkbox
             when WIXUI_EXITDIALOGOPTIONALCHECKBOX is set; clicking it
             fires the LaunchApplication custom action which shells the
             installed exe via WixShellExec.

             WixShellExecTarget must be a formatted property that points
             at the just-installed binary; '[#exe0]' resolves to the full
             path of the File element with Id='exe0' (the .exe component
             above).

             Return='asyncNoWait' so the installer process exits
             immediately instead of blocking on the launched app's
             window. Impersonate='yes' runs the app as the invoking
             user rather than SYSTEM (the perMachine MSI runs elevated;
             without impersonation the launched exe would also run
             elevated, which Steam/SteamVR clients don't accept). -->
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOX' Value='1'/>
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT'
                  Value='Launch EZ Wishlist Overlay'/>
        <Property Id='WixShellExecTarget' Value='[#exe0]'/>
        <CustomAction Id='LaunchApplication'
                      BinaryKey='WixCA'
                      DllEntry='WixShellExec'
                      Impersonate='yes'
                      Return='asyncNoWait'/>
        <UI>
            <Publish Dialog='ExitDialog'
                     Control='Finish'
                     Event='DoAction'
                     Value='LaunchApplication'>WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
        </UI>

    </Product>
</Wix>
