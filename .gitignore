/target/
**/*.rs.bk
Cargo.lock.bak

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Runtime user data (don't commit)
state.json

# Scraper temp dir
.scraper-cache/

# Per-clone Claude Code agent state (scheduled tasks, local settings)
.claude/

# Local dev-loop diagnostic dumps (script-redirected stdout, fn-table probes,
# OCR scratch). Useful for in-flight debugging but never meant to land in git.
dev.log
vr-fntable.txt
ocr_data/

# Native VR captures used for digit-template extraction and future OCR
# regression. Each PNG is ~10 MB lossless; we keep them locally as
# ground-truth references but don't commit by default. To commit a
# specific fixture (e.g. for the integration test), `git add -f
# hideout_screenshots_native/<UpgradeId>.png`.
hideout_screenshots_native/*.png
